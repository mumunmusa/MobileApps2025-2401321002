<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.TapeTransfer" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/lime</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/ink</item>
        <item name="colorOnSecondary">@color/lime</item>
        <item name="colorSecondaryContainer">@color/ink</item>
        <item name="colorOnSecondaryContainer">@color/lime</item>
        <item name="colorError">@color/error</item>

        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="colorSurface">@color/background_light</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/surface_light</item>
        <item name="colorSurfaceContainerLow">@color/surface_light</item>
        <item name="colorSurfaceContainer">@color/surface_light</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant_light</item>
        <item name="colorOutline">@color/outline_light</item>
        <item name="colorOutlineVariant">@color/outline_variant_light</item>

        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.TapeTransfer.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.TapeTransfer.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.TapeTransfer.Large</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
