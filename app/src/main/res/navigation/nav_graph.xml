<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="bg.uni_plovdiv.fmi.tapetransfer.ui.login.LoginFragment"
        android:label="@string/login_button">
        <action
            android:id="@+id/action_login_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="bg.uni_plovdiv.fmi.tapetransfer.ui.dashboard.DashboardFragment"
        android:label="@string/dashboard_title" />

</navigation>
