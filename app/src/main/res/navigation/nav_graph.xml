<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="bg.uni_plovdiv.fmi.tapetransfer.ui.login.LoginFragment"
        android:label="@string/login_button">
        <action
            android:id="@+id/action_login_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="bg.uni_plovdiv.fmi.tapetransfer.ui.register.RegisterFragment"
        android:label="@string/register_title" />

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="bg.uni_plovdiv.fmi.tapetransfer.ui.dashboard.DashboardFragment"
        android:label="@string/dashboard_title">
        <action
            android:id="@+id/action_dashboard_to_addEditOrder"
            app:destination="@id/addEditOrderFragment" />
        <action
            android:id="@+id/action_dashboard_to_orderDetail"
            app:destination="@id/orderDetailFragment" />
        <action
            android:id="@+id/action_dashboard_to_ordersList"
            app:destination="@id/ordersListFragment" />
        <action
            android:id="@+id/action_dashboard_to_revenue"
            app:destination="@id/revenueFragment" />
    </fragment>

    <fragment
        android:id="@+id/ordersListFragment"
        android:name="bg.uni_plovdiv.fmi.tapetransfer.ui.orders.OrdersListFragment"
        android:label="@string/orders_active_title">
        <argument
            android:name="showDone"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_ordersList_to_orderDetail"
            app:destination="@id/orderDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/revenueFragment"
        android:name="bg.uni_plovdiv.fmi.tapetransfer.ui.revenue.RevenueFragment"
        android:label="@string/revenue_title" />

    <fragment
        android:id="@+id/orderDetailFragment"
        android:name="bg.uni_plovdiv.fmi.tapetransfer.ui.detail.OrderDetailFragment"
        android:label="@string/detail_title">
        <argument
            android:name="orderId"
            app:argType="integer" />
        <action
            android:id="@+id/action_orderDetail_to_addEditOrder"
            app:destination="@id/addEditOrderFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEditOrderFragment"
        android:name="bg.uni_plovdiv.fmi.tapetransfer.ui.order.AddEditOrderFragment"
        android:label="@string/order_new_title">
        <argument
            android:name="orderId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

</navigation>
